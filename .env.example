# Postgres connection string (Neon in production, `prisma dev` locally)
DATABASE_URL="postgresql://user:password@localhost:51213/kpma?sslmode=disable"

# Random secret used to sign session cookies. Generate your own with:
#   openssl rand -hex 32
SESSION_SECRET="replace-with-a-long-random-string"

# Main client dashboard login (username in plain text, password as a bcrypt hash).
# `npm run auth:generate main` prints a ready-to-paste line for this value —
# note every `$` in the hash must be escaped as `\$`, or Next.js's .env
# variable-expansion will corrupt it.
MAIN_AUTH_USER="admin"
MAIN_AUTH_PASS_HASH="replace-with-bcrypt-hash"

# Worker/payroll dashboard login — deliberately separate credentials.
# `npm run auth:generate worker` prints this one.
WORKER_AUTH_USER="admin"
WORKER_AUTH_PASS_HASH="replace-with-bcrypt-hash"
