generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum PaymentStatus {
  PAID
  UNPAID
  PARTIAL
}

model Category {
  id        String   @id @default(cuid())
  name      String   @unique
  slug      String   @unique
  icon      String   @default("sparkles")
  createdAt DateTime @default(now())

  clientCategories ClientCategory[]

  @@map("categories")
}

model Client {
  id            String   @id @default(cuid())
  name          String
  logoDriveLink String?
  logoUrl       String?
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  categories ClientCategory[]

  @@map("clients")
}

model ClientCategory {
  id            String   @id @default(cuid())
  clientId      String
  categoryId    String
  monthlyAmount Decimal  @db.Decimal(12, 2)
  createdAt     DateTime @default(now())

  client   Client     @relation(fields: [clientId], references: [id], onDelete: Cascade)
  category Category   @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  payments Payment[]

  @@unique([clientId, categoryId])
  @@map("client_categories")
}

model Payment {
  id               String        @id @default(cuid())
  clientCategoryId String
  year             Int
  month            Int
  status           PaymentStatus @default(UNPAID)
  amountPaid       Decimal       @default(0) @db.Decimal(12, 2)
  paidDate         DateTime?
  notes            String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  clientCategory ClientCategory @relation(fields: [clientCategoryId], references: [id], onDelete: Cascade)

  @@unique([clientCategoryId, year, month])
  @@map("payments")
}

model Worker {
  id            String   @id @default(cuid())
  name          String
  role          String?
  monthlySalary Decimal  @db.Decimal(12, 2)
  notes         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  payments SalaryPayment[]

  @@map("workers")
}

model SalaryPayment {
  id         String        @id @default(cuid())
  workerId   String
  year       Int
  month      Int
  status     PaymentStatus @default(UNPAID)
  amountPaid Decimal       @default(0) @db.Decimal(12, 2)
  paidDate   DateTime?
  notes      String?
  createdAt  DateTime      @default(now())
  updatedAt  DateTime      @updatedAt

  worker Worker @relation(fields: [workerId], references: [id], onDelete: Cascade)

  @@unique([workerId, year, month])
  @@map("salary_payments")
}
